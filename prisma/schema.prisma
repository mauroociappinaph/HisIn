generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Skill {
  VOCABULARY
  GRAMMAR
  READING
  LISTENING
  BUSINESS
  CONTRACTS
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRUE_FALSE
  LISTENING_MCQ
}

/// Durable learner state. XP, streak and level lived in localStorage before this,
/// which meant clearing the browser erased months of practice.
model LearnerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         CefrLevel @default(B1)
  goal          String    @default("interviews")
  dailyGoal     Int       @default(10)
  xp            Int       @default(0)
  streak        Int       @default(0)
  bestStreak    Int       @default(0)
  lastActiveDay String?
  itemsToday    Int       @default(0)
  totalItems    Int       @default(0)
  totalCorrect  Int       @default(0)
  onboardedAt   DateTime?
  discipline     String   @default("negocios")
  educationLevel String   @default("grado_inicial")
  educationMix   Json?
  classMinutes   Int      @default(60)
  sequence       String   @default("semanal")
  classPlans     ClassPlan[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// One designed session: the teaching context plus the minute-by-minute flow the
/// app generated for it. Stored as a snapshot so a plan never changes under the
/// learner when the algorithm is tuned later.
model ClassPlan {
  id             String   @id @default(cuid())
  userId         String
  user           LearnerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  discipline     String
  educationLevel String
  minutes        Int
  sequence       String
  topic          String
  flow           Json
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

enum TopicSkill {
  GRAMMAR
  READING
  LISTENING
  WRITING
}

/// A syllabus topic (Tema 1: verb to be) whose four skill materials are written
/// by the engine for healthtech founders, never for a generic learner.
model Topic {
  id        String          @id @default(cuid())
  slug      String          @unique
  title     String
  ord       Int             @default(0)
  level     CefrLevel
  focus     String?
  createdAt DateTime        @default(now())
  materials TopicMaterial[]
}

model TopicMaterial {
  id        String     @id @default(cuid())
  topicId   String
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  skill     TopicSkill
  title     String
  body      String     @db.Text
  keyPoints String[]
  createdAt DateTime   @default(now())

  @@unique([topicId, skill])
  @@index([topicId])
}

/// A real article from a healthtech or startup feed, plus the analysis the engine
/// extracted from it: the vocabulary and patterns a learner should notice.
model NewsArticle {
  id          String    @id @default(cuid())
  url         String    @unique
  title       String
  source      String
  excerpt     String    @db.Text
  publishedAt DateTime?
  analysis    Json?
  analyzedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

model Question {
  id          String       @id @default(cuid())
  level       CefrLevel
  skill       Skill
  type        QuestionType
  prompt      String
  options     Json
  answer      String
  explanation String?
  audioUrl    String?
  /// For listening items: the real video and the second where the line is said,
  /// so the learner hears it in context instead of a synthesised clip.
  youtubeVideoId String?
  youtubeStartSec Int?
  tags        String[]
  createdAt   DateTime     @default(now())

  @@index([level, skill])
}

model Lesson {
  id          String     @id @default(cuid())
  module      String
  level       CefrLevel
  title       String
  summary     String
  content     String     @db.Text
  order       Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([module, level])
}

enum VocabularyKind {
  WORD
  PHRASAL_VERB
  PATTERN
  IDIOM
}

enum VocabularySource {
  SEED
  GENERATED
  USER
}

model Vocabulary {
  id           String           @id @default(cuid())
  term         String
  definition   String
  example      String
  module       String
  level        CefrLevel
  kind         VocabularyKind   @default(WORD)
  particle     String?
  source       VocabularySource @default(SEED)
  extraExample String?
  notes        String?
  separable    Boolean?
  register     String?
  function     String?
  createdAt    DateTime         @default(now())
  reviews      VocabularyReview[]

  @@index([module, level])
  @@index([kind])
}

/// A short generated narrative that recycles target vocabulary in context.
model VocabularyStory {
  id          String     @id @default(cuid())
  module      String
  level       CefrLevel
  title       String
  body        String     @db.Text
  translation String     @db.Text
  targetWords String[]
  createdAt   DateTime   @default(now())

  @@unique([module, level, title])
  @@index([module, level])
}

model Module {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  icon        String
  order       Int        @default(0)
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  level         CefrLevel  @default(B1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  vocabReviews  VocabularyReview[]
  profile       LearnerProfile?
  completions   LessonCompletion[]
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// One Gentle Shell generation attempt, kept for audit even when it fails.
model GenerationJob {
  id           String           @id @default(cuid())
  kind         String
  status       GenerationStatus @default(PENDING)
  request      Json
  prompt       String           @db.Text
  model        String
  output       Json?
  error        String?
  createdCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status, createdAt])
}

model VocabularyReview {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyId    String
  vocabulary      Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  easeFactor      Float      @default(2.5)
  interval        Int        @default(0)
  repetitions     Int        @default(0)
  nextReview      DateTime   @default(now())
  lastReviewed    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, vocabularyId])
  @@index([userId, nextReview])
}
