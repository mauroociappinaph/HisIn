generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Skill {
  VOCABULARY
  GRAMMAR
  READING
  LISTENING
  BUSINESS
  CONTRACTS
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRUE_FALSE
  LISTENING_MCQ
}

model Question {
  id          String       @id @default(cuid())
  level       CefrLevel
  skill       Skill
  type        QuestionType
  prompt      String
  options     Json
  answer      String
  explanation String?
  audioUrl    String?
  tags        String[]
  createdAt   DateTime     @default(now())

  @@index([level, skill])
}

model Lesson {
  id          String     @id @default(cuid())
  module      String
  level       CefrLevel
  title       String
  summary     String
  content     String     @db.Text
  order       Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([module, level])
}

enum VocabularyKind {
  WORD
  PHRASAL_VERB
  PATTERN
}

enum VocabularySource {
  SEED
  GENERATED
  USER
}

model Vocabulary {
  id           String           @id @default(cuid())
  term         String
  definition   String
  example      String
  module       String
  level        CefrLevel
  kind         VocabularyKind   @default(WORD)
  particle     String?
  source       VocabularySource @default(SEED)
  extraExample String?
  notes        String?
  createdAt    DateTime         @default(now())
  reviews      VocabularyReview[]

  @@index([module, level])
  @@index([kind])
}

/// A short generated narrative that recycles target vocabulary in context.
model VocabularyStory {
  id          String     @id @default(cuid())
  module      String
  level       CefrLevel
  title       String
  body        String     @db.Text
  translation String     @db.Text
  targetWords String[]
  createdAt   DateTime   @default(now())

  @@unique([module, level, title])
  @@index([module, level])
}

model Module {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  icon        String
  order       Int        @default(0)
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  level         CefrLevel  @default(B1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  vocabReviews  VocabularyReview[]
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// One Gentle Shell generation attempt, kept for audit even when it fails.
model GenerationJob {
  id           String           @id @default(cuid())
  kind         String
  status       GenerationStatus @default(PENDING)
  request      Json
  prompt       String           @db.Text
  model        String
  output       Json?
  error        String?
  createdCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status, createdAt])
}

model VocabularyReview {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyId    String
  vocabulary      Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  easeFactor      Float      @default(2.5)
  interval        Int        @default(0)
  repetitions     Int        @default(0)
  nextReview      DateTime   @default(now())
  lastReviewed    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, vocabularyId])
  @@index([userId, nextReview])
}
